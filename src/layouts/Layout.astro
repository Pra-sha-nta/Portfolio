---
import '../styles/global.css';
import { profile, seo } from '../data/content';

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(seo.ogImage, Astro.site).href;

/** Schema.org Person - lets search engines read the role and employer directly. */
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.role,
  email: `mailto:${profile.email}`,
  telephone: profile.phoneHref,
  url: profile.site,
  image: ogImage,
  description: seo.description,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Bhaktapur',
    addressCountry: 'NP',
  },
  worksFor: { '@type': 'Organization', name: 'Ek ra Sunya Inc' },
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: 'Swoyambhu International College (Tribhuvan University)',
  },
  knowsAbout: [
    'Software Testing',
    'Quality Assurance',
    'Manual Testing',
    'API Testing',
    'Regression Testing',
    'Role-Based Access Control Testing',
  ],
  sameAs: [profile.links.linkedin, profile.links.github],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0a0b0d" />
    <meta name="author" content={profile.name} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${profile.name} - ${profile.role}`} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Inter+Tight:wght@500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
    />

    <script is:inline set:html={JSON.stringify(jsonLd)} type="application/ld+json" />

    {/* Mark JS as available before paint, so reveal states never flash or strand content. */}
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>

  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-signal focus:px-4 focus:py-2 focus:font-medium focus:text-canvas"
    >
      Skip to content
    </a>
    <slot />
    <script>
      import '../scripts/motion.ts';
    </script>
  </body>
</html>
