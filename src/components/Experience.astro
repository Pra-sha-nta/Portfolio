---
import Section from './Section.astro';
import { experience } from '../data/content';
---

<Section
  id="experience"
  index="02 / Experience"
  title="Where I've tested."
  lead="Three QA roles, from website review through to role-based access and API testing on live business platforms."
>
  <ol class="relative space-y-4">
    <!-- Trace line: the spine of the traceability timeline. -->
    <span
      class="absolute left-[7px] top-3 bottom-3 hidden w-px bg-gradient-to-b from-line via-line to-transparent sm:block"
      aria-hidden="true"
    ></span>

    {
      experience.map((role) => (
        <li data-reveal class="relative sm:pl-10">
          <span
            class="absolute left-0 top-7 hidden h-[15px] w-[15px] items-center justify-center rounded-full border border-line bg-canvas sm:flex"
            aria-hidden="true"
          >
            <span
              class={`h-1.5 w-1.5 rounded-full ${role.current ? 'bg-signal' : 'bg-faint'}`}
            />
          </span>

          <article class="group rounded-xl border border-line bg-surface p-6 transition-colors duration-300 hover:border-faint/50 sm:p-8">
            <div class="flex flex-wrap items-start justify-between gap-x-6 gap-y-2">
              <div>
                <h3 class="text-xl font-semibold tracking-tight text-ink">{role.title}</h3>
                <p class="mt-1 text-muted">
                  {role.company} <span class="text-faint">· {role.location}</span>
                </p>
              </div>
              <div class="flex items-center gap-2.5">
                {role.current && (
                  <span class="flex items-center gap-1.5 rounded-full bg-signal/10 px-2.5 py-1">
                    <span class="h-1 w-1 rounded-full bg-signal" aria-hidden="true" />
                    <span class="font-mono text-[0.625rem] tracking-[0.12em] text-signal uppercase">
                      Current
                    </span>
                  </span>
                )}
                <span class="font-mono text-xs whitespace-nowrap text-faint">{role.period}</span>
              </div>
            </div>

            {role.platforms.length > 0 && (
              <ul class="mt-5 flex flex-wrap gap-2">
                {role.platforms.map((p) => (
                  <li class="rounded-md border border-line bg-surface-2 px-2.5 py-1 font-mono text-xs text-muted">
                    {p}
                  </li>
                ))}
              </ul>
            )}

            <ul class="mt-6 space-y-3">
              {role.points.map((point) => (
                <li class="flex gap-3.5 text-[0.9375rem] leading-relaxed text-muted">
                  <span
                    class="mt-[0.6em] h-px w-3 shrink-0 bg-faint transition-colors duration-300 group-hover:bg-signal"
                    aria-hidden="true"
                  />
                  <span>{point}</span>
                </li>
              ))}
            </ul>
          </article>
        </li>
      ))
    }
  </ol>
</Section>
