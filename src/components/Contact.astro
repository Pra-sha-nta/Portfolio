---
import { profile, references } from '../data/content';

const socials = [
  { label: 'LinkedIn', href: profile.links.linkedin },
  { label: 'GitHub', href: profile.links.github },
  { label: 'Instagram', href: profile.links.instagram },
] as const;
---

<section id="contact" class="relative overflow-hidden pt-20 sm:pt-28">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <div data-reveal class="mb-14">
      <div class="mb-4 flex items-center gap-4">
        <span class="label">07 / Contact</span>
        <span class="rule flex-1"></span>
      </div>
      <h2
        class="font-[family-name:var(--font-display)] text-[clamp(2rem,6vw,4.5rem)] font-semibold leading-[1.02] tracking-[-0.025em]"
      >
        Hiring for QA?<br />
        <span class="text-muted">Let's talk.</span>
      </h2>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-muted">
        Open to Junior, Manual and Associate QA Engineer roles, and to software testing
        positions in Kathmandu or remote.
      </p>
    </div>

    <div data-reveal class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <a
        href={`mailto:${profile.email}`}
        class="group rounded-xl border border-line bg-surface p-6 transition-colors duration-300 hover:border-signal/40 hover:bg-surface-2"
      >
        <p class="label mb-2.5">Email</p>
        <p class="break-all font-medium text-ink transition-colors group-hover:text-signal">
          {profile.email}
        </p>
      </a>
      <a
        href={`tel:${profile.phoneHref}`}
        class="group rounded-xl border border-line bg-surface p-6 transition-colors duration-300 hover:border-signal/40 hover:bg-surface-2"
      >
        <p class="label mb-2.5">Phone</p>
        <p class="font-medium text-ink transition-colors group-hover:text-signal">
          {profile.phone}
        </p>
      </a>
      <div class="rounded-xl border border-line bg-surface p-6 sm:col-span-2 lg:col-span-1">
        <p class="label mb-2.5">Location</p>
        <p class="font-medium text-ink">{profile.location}</p>
      </div>
    </div>

    <div data-reveal class="mt-14">
      <p class="label mb-4">References</p>
      <ul class="grid gap-4 sm:grid-cols-2">
        {
          references.map((ref) => (
            <li class="rounded-xl border border-line bg-surface px-6 py-5">
              <p class="font-medium text-ink">{ref.name}</p>
              <p class="mt-1 text-sm text-muted">{ref.title}</p>
            </li>
          ))
        }
      </ul>
      <p class="mt-4 text-sm text-faint">Contact details available on request.</p>
    </div>
  </div>

  <footer class="mt-24 border-t border-line/60">
    <div
      class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-6 px-5 py-8 sm:px-8"
    >
      <p class="font-mono text-xs text-faint">
        © {new Date().getFullYear()} {profile.name}
      </p>
      <ul class="flex flex-wrap items-center gap-6">
        {
          socials.map((social) => (
            <li>
              <a
                href={social.href}
                target="_blank"
                rel="noopener noreferrer"
                class="text-sm text-muted transition-colors hover:text-ink"
              >
                {social.label}
              </a>
            </li>
          ))
        }
        <li>
          <a
            href={profile.cv}
            download
            class="text-sm text-muted transition-colors hover:text-signal"
          >
            CV
          </a>
        </li>
      </ul>
    </div>
  </footer>
</section>
