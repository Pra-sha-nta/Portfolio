---
import Section from './Section.astro';
import { repos, profile } from '../data/content';
---

<Section
  id="projects"
  num="06"
  label="Learning"
  title="Learning in"
  accent="the open."
  lead="Separate from my professional QA work: coursework builds and the JavaScript groundwork I'm doing toward test automation."
>
  <ol class="border-t border-line">
    {
      repos.map((repo, i) => (
        <li data-reveal>
          <a
            href={repo.url}
            target="_blank"
            rel="noopener noreferrer"
            data-row
            class="group relative grid gap-3 border-b border-line py-8 sm:grid-cols-12 sm:items-baseline sm:gap-8"
          >
            <span class="label sm:col-span-1">{String(i + 1).padStart(2, '0')}</span>
            <span class="relative sm:col-span-5">
              <span class="display block text-[clamp(2.25rem,5vw,4.25rem)] text-ink transition-colors group-hover:text-sun group-focus-visible:text-sun">
                {repo.name}
              </span>
              <span
                data-row-line
                class="absolute -bottom-1 left-0 h-px w-full origin-left scale-x-0 bg-sun"
                aria-hidden="true"
              />
            </span>
            <span class="text-muted sm:col-span-4">{repo.description}</span>
            <span class="flex items-center justify-between gap-4 sm:col-span-2 sm:justify-end">
              <span class="label">{repo.tags.join(' / ')}</span>
              <svg
                data-row-arrow
                class="h-5 w-5 shrink-0 text-ink"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                aria-hidden="true"
              >
                <path d="M4 12h16m-6-6 6 6-6 6" />
              </svg>
            </span>
            <span class="sr-only">(opens GitHub in a new tab)</span>
          </a>
        </li>
      ))
    }
  </ol>

  <a
    data-reveal
    href={profile.links.github}
    target="_blank"
    rel="noopener noreferrer"
    class="label mt-8 inline-flex items-center gap-2 text-ink underline-offset-4 hover:text-sun hover:underline"
  >
    All repositories on GitHub
    <span aria-hidden="true">↗</span>
  </a>
</Section>
