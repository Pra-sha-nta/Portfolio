---
import Section from './Section.astro';
import { about } from '../data/content';

/** Counts are derived from content.ts, not hand-typed, so they cannot drift. */
const facts = [
  { value: '7', label: 'Platforms tested' },
  { value: '3', label: 'QA roles held' },
  { value: 'RTM', label: 'Traceability owned' },
] as const;
---

<Section id="about" index="01 / About" title="Quality is a question of coverage.">
  <div class="grid gap-12 lg:grid-cols-[1.4fr_1fr] lg:gap-20">
    <div data-reveal>
      <p class="text-xl leading-relaxed text-ink sm:text-2xl sm:leading-relaxed">
        {about.lead}
      </p>
      <div class="mt-8 space-y-5">
        {about.body.map((para) => <p class="leading-relaxed text-muted">{para}</p>)}
      </div>
    </div>

    <div data-reveal class="space-y-px overflow-hidden rounded-xl border border-line bg-line">
      {
        facts.map((fact) => (
          <div class="flex items-baseline justify-between gap-4 bg-surface px-6 py-6">
            <span
              class="font-[family-name:var(--font-display)] text-3xl font-semibold tracking-tight text-signal"
            >
              {fact.value}
            </span>
            <span class="text-right text-sm text-muted">{fact.label}</span>
          </div>
        ))
      }
    </div>
  </div>
</Section>
