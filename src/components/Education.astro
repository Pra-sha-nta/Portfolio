---
import Section from './Section.astro';
import { education, certifications } from '../data/content';
---

<Section id="education" index="05 / Education" title="Background.">
  <div class="grid gap-14 lg:grid-cols-2 lg:gap-20">
    <div data-reveal>
      <ol class="space-y-px overflow-hidden rounded-xl border border-line bg-line">
        {
          education.map((item) => (
            <li class="bg-surface px-6 py-6">
              <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                <h3 class="font-semibold tracking-tight text-ink">{item.qualification}</h3>
                <span class="font-mono text-xs whitespace-nowrap text-faint">{item.period}</span>
              </div>
              <p class="mt-1.5 text-sm text-muted">{item.school}</p>
              {item.result && (
                <p class="mt-3 font-mono text-xs tracking-[0.1em] text-signal uppercase">
                  {item.result}
                </p>
              )}
            </li>
          ))
        }
      </ol>
    </div>

    <div data-reveal>
      <p class="label mb-4">Training & certifications</p>
      <ul class="space-y-4">
        {
          certifications.map((cert) => (
            <li class="rounded-xl border border-line bg-surface p-6">
              <h3 class="font-semibold tracking-tight text-ink">{cert.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">{cert.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</Section>
