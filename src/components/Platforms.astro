---
import { platforms, experience } from '../data/content';

const role = experience[0];
---

<!--
  Desktop: GSAP pins this section and runs the track sideways (cinema.ts).
  Below 1024px, or with reduced motion, it is an ordinary list.
-->
<section
  id="field"
  data-reel
  aria-labelledby="field-title"
  class="relative overflow-hidden border-y border-line bg-surface lg:flex lg:h-[100svh] lg:flex-col lg:justify-center"
>
  <div class="mx-auto w-full max-w-[88rem] px-5 pt-20 sm:px-8 lg:px-12 lg:pt-0">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div>
        <p class="label mb-4"><span class="text-sun">02.1</span> &nbsp;In the field</p>
        <h2 id="field-title" data-split class="display text-[clamp(2.25rem,5vw,4.5rem)] text-ink">
          {platforms.length} platforms, <em>tested under real roles.</em>
        </h2>
      </div>
      <p data-reveal class="label max-w-xs">
        Named under {role.title}, {role.company}. {role.period}.
      </p>
    </div>
  </div>

  <ol
    data-reel-track
    class="mt-12 flex flex-col px-5 pb-20 sm:px-8 lg:mt-16 lg:w-max lg:flex-row lg:items-end lg:gap-[6vw] lg:pr-[30vw] lg:pb-0 lg:pl-12"
  >
    {
      platforms.map((name, i) => (
        <li class="flex items-baseline gap-4 border-b border-line py-4 lg:block lg:border-0 lg:py-0">
          <span class="label block w-10 shrink-0 text-sun lg:mb-3">
            P-{String(i + 1).padStart(2, '0')}
          </span>
          <span class="relative block whitespace-nowrap">
            <span class="display outline-text block text-[clamp(2.5rem,9vw,4rem)] lg:text-[clamp(5rem,11vw,11rem)]">
              {name}
            </span>
            <span
              data-reel-fill
              aria-hidden="true"
              class="display absolute inset-0 hidden text-ink lg:block lg:text-[clamp(5rem,11vw,11rem)]"
            >
              {name}
            </span>
          </span>
        </li>
      ))
    }
  </ol>

  <div class="mx-auto hidden w-full max-w-[88rem] px-12 pt-14 lg:block" aria-hidden="true">
    <div class="h-px w-full bg-line">
      <div data-reel-progress class="h-px w-full origin-left bg-sun"></div>
    </div>
  </div>
</section>
