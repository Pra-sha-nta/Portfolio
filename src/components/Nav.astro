---
import { nav, profile } from '../data/content';
---

<header
  class="fixed inset-x-0 top-0 z-40 border-b border-line/60 bg-canvas/80 backdrop-blur-xl"
>
  <nav
    aria-label="Primary"
    class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-5 sm:px-8"
  >
    <a href="#top" class="group flex items-center gap-2.5 shrink-0">
      <span class="relative flex h-2 w-2" aria-hidden="true">
        <span class="absolute inline-flex h-full w-full rounded-full bg-signal opacity-60"></span>
        <span class="relative inline-flex h-2 w-2 rounded-full bg-signal"></span>
      </span>
      <span class="font-mono text-sm font-medium tracking-tight text-ink">
        prashanta<span class="text-faint">.qa</span>
      </span>
    </a>

    <ul class="hidden items-center gap-1 md:flex">
      {
        nav.map((item) => (
          <li>
            <a
              href={item.href}
              data-navlink
              class="group relative rounded-md px-3 py-2 text-sm text-muted transition-colors hover:text-ink data-[active=true]:text-ink"
            >
              {item.label}
              <span class="absolute inset-x-3 -bottom-px h-px scale-x-0 bg-signal transition-transform duration-300 ease-[var(--ease-out-expo)] group-hover:scale-x-100 group-data-[active=true]:scale-x-100" />
            </a>
          </li>
        ))
      }
    </ul>

    <a
      href={profile.cv}
      download
      class="group flex shrink-0 items-center gap-2 rounded-full border border-line bg-surface px-4 py-2 text-sm font-medium text-ink transition-colors hover:border-signal/50 hover:bg-surface-2"
    >
      <svg
        class="h-3.5 w-3.5 text-signal transition-transform duration-300 group-hover:translate-y-0.5"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M12 3v12m0 0 4-4m-4 4-4-4M4 19h16" />
      </svg>
      <span class="hidden sm:inline">Download CV</span>
      <span class="sm:hidden">CV</span>
    </a>
  </nav>
</header>
