---
import { profile, references } from '../data/content';

const socials = [
  { label: 'LinkedIn', href: profile.links.linkedin },
  { label: 'GitHub', href: profile.links.github },
  { label: 'Instagram', href: profile.links.instagram },
] as const;
---

<footer class="relative bg-canvas text-ink">
  <div class="mx-auto max-w-[88rem] px-5 pt-20 pb-10 sm:px-8 lg:px-12">
    <div class="grid gap-12 border-b border-line pb-14 md:grid-cols-12 md:gap-8">
      <div class="md:col-span-5">
        <p class="label mb-4 text-sun">Direct</p>
        <a
          href={`mailto:${profile.email}`}
          class="block break-all font-[family-name:var(--font-serif)] text-[clamp(1.5rem,3vw,2.25rem)] text-ink hover:text-sun"
        >
          {profile.email}
        </a>
        <a href={`tel:${profile.phoneHref}`} class="mt-3 block font-mono text-sm text-muted hover:text-sun">
          {profile.phone}
        </a>
        <p class="mt-1 font-mono text-sm text-muted">{profile.location}</p>
      </div>

      <div class="md:col-span-4">
        <p class="label mb-4">References</p>
        <ul class="space-y-4">
          {
            references.map((ref) => (
              <li>
                <p class="text-ink">{ref.name}</p>
                <p class="text-sm text-muted">{ref.title}</p>
              </li>
            ))
          }
        </ul>
        <p class="mt-4 text-sm text-faint">Contact details available on request.</p>
      </div>

      <div class="md:col-span-3">
        <p class="label mb-4">Elsewhere</p>
        <ul class="space-y-2">
          {
            socials.map((s) => (
              <li>
                <a href={s.href} target="_blank" rel="noopener noreferrer" class="text-ink hover:text-sun">
                  {s.label} <span aria-hidden="true">↗</span>
                  <span class="sr-only">(opens in a new tab)</span>
                </a>
              </li>
            ))
          }
          <li>
            <a href={profile.cv} download class="text-ink hover:text-sun">Download CV</a>
          </li>
        </ul>
      </div>
    </div>

    <p class="outline-text display mt-10 text-[clamp(3.5rem,15vw,13rem)] leading-[0.85] select-none" aria-hidden="true">
      Parajuli
    </p>
    <div class="mt-8 flex flex-wrap items-center justify-between gap-4">
      <p class="font-mono text-xs text-faint">© {new Date().getFullYear()} {profile.name}</p>
      <a href="#main" class="label hover:text-sun">Back to top ↑</a>
    </div>
  </div>
</footer>
